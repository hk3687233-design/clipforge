# ── Database (Neon free tier) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/dbname

# ── Cloudflare R2 (free 10 GB, optional) ───────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clipforge
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxx.r2.dev   # optional, leave blank to use presigned URLs

# ── Gumroad (payments) ────────────────────────────────────────────────────
GUMROAD_ACCESS_TOKEN=
GUMROAD_PRODUCT_ID=
GUMROAD_SELLER_ID=

# ── Gemini Flash (FREE tier — get key from aistudio.google.com, no credit card) ──
# Free: 1M tokens/day, 15 RPM. Powers intelligent product detection from transcripts.
# Without this key the tool falls back to Whisper-only detection (less accurate).
GEMINI_API_KEY=

# ── App settings ────────────────────────────────────────────────────────────
MAX_VIDEO_SIZE_MB=500
TEMP_DIR=/tmp/clipforge
WHISPER_MODEL=tiny    # tiny | base | small — tiny is fastest, fine for most videos
